# Database / auth
MONGODB_URI=
PORT=5000
JWT_SECRET=

# Seed scripts (chỉ cần khi chạy seed local)
SEED_DEFAULT_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FAILOPEN=false

# VIP / sandbox
PAYMENTS_SANDBOX=false
VIP_PRICE_1D=5000
VIP_PRICE_1M=99000

# Google login backend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: FastAPI/TensorFlow cover moderation service deployed elsewhere.
# Leave blank on Netlify to skip cover-image AI moderation without calling localhost.
AI_SERVICE_URL=

# Gemini chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional. On Netlify, code falls back to the automatic URL environment variable.
PUBLIC_SITE_URL=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Optional text moderation
OPENAI_API_KEY=
